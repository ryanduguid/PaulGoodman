{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fadden extracted Markdown manifest rows",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "collection",
      "isPrincipal",
      "isInForce",
      "status",
      "versionStart",
      "compilationRegisterId",
      "sourceUrl",
      "retrieved",
      "markdown",
      "sections",
      "words",
      "granularity"
    ],
    "properties": {
      "id": {
        "$ref": "#/$defs/registerId"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "collection": {
        "type": "string",
        "minLength": 1
      },
      "isPrincipal": {
        "type": "boolean"
      },
      "isInForce": {
        "type": "boolean"
      },
      "status": {
        "type": "string",
        "minLength": 1
      },
      "versionStart": {
        "$ref": "#/$defs/date"
      },
      "compilationRegisterId": {
        "anyOf": [
          {
            "$ref": "#/$defs/registerId"
          },
          {
            "type": "null"
          }
        ]
      },
      "sourceUrl": {
        "type": "string",
        "pattern": "^https://www\\.legislation\\.gov\\.au/.+"
      },
      "retrieved": {
        "$ref": "#/$defs/date"
      },
      "markdown": {
        "type": "string",
        "minLength": 1
      },
      "sections": {
        "type": "integer",
        "minimum": 0
      },
      "words": {
        "type": "integer",
        "minimum": 0
      },
      "granularity": {
        "enum": [
          "section",
          "table_block",
          "whole_act"
        ]
      },
      "version_is_current": {
        "type": "boolean"
      },
      "current_version_start": {
        "$ref": "#/$defs/date"
      },
      "current_version_has_document": {
        "type": "boolean"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "ok_superseded_version"
            }
          }
        },
        "then": {
          "required": [
            "version_is_current",
            "current_version_start",
            "current_version_has_document"
          ],
          "properties": {
            "version_is_current": {
              "const": false
            }
          }
        }
      }
    ]
  },
  "$defs": {
    "registerId": {
      "type": "string",
      "pattern": "^[CF][0-9]{4}[A-Z][0-9]{5}$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
